{
    "name": "sharkyphp/foundation",
    "description": "SharkyPHP foundation, core framework foundation library.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Sharky\\Foundation\\": "src"
        }
    },
    "authors": [
        {
            "name": "bytesharky",
            "email": "fish@doffish.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "composer-runtime-api": "^2.0",
        "psr/container": "^2.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "sharkyphp/cache": "^2.0.0",
        "sharkyphp/clock": "^2.0.0",
        "sharkyphp/authorization": "^2.0.0",
        "sharkyphp/console": "^2.0.0",
        "sharkyphp/container": "^2.0.0",
        "sharkyphp/contracts": "^2.0.0",
        "sharkyphp/database": "^2.0.0",
        "sharkyphp/event": "^2.0.0",
        "sharkyphp/facade": "^2.0.0",
        "sharkyphp/http": "^2.0.0",
        "sharkyphp/invoker": "^2.0.0",
        "sharkyphp/log": "^2.0.0",
        "sharkyphp/pipeline": "^2.0.0",
        "sharkyphp/redis": "^2.0.0",
        "sharkyphp/session": "^2.0.0",
        "sharkyphp/skeleton": "^2.0.0",
        "sharkyphp/support": "^2.0.0",
        "sharkyphp/template": "^2.0.0"
    },
    "archive": {
        "exclude": [
            "docs/",
            "tests/",
            ".github/",
            ".gitignore",
            "composer.lock",
            "vendor/",
            ".env"
        ]
    }
}
